				_Array()
			</constant><constant name="kPIFTSupplyStateLowConditionMask">0x00000800</constant><constant name="kPIFTSupplyStateVeryLowConditionMask">0x40000000</constant><constant name="kPIFTSupplyStateOutConditionMask">0x00001000</constant><constant name="kPIFTLOISupplyAdditionalInfo">
				_Array(
