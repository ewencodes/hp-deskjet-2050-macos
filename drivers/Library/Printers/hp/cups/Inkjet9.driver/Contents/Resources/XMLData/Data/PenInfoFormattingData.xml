				_Array(
					4,
					10,
					16,
					18
				)
			</constant><constant name="kPIFTDMFSupplyMarkerTypes">
				_Dictionary(
					"toner",					3,
					"wasteToner",			4,
					"ink",					5,
					"ink",					6,
					"ink",					7,
